{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "node",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "resources/js/*"
            ],
            "ziggy-js": [
                "vendor/tightenco/ziggy/dist/index.js"
            ]
        },
        "jsx": "preserve",
        "lib": [
            "esnext",
            "dom"
        ],
        "allowJs": true,
        "checkJs": false
    },
    "exclude": [
        "node_modules",
        "public"
    ]
}